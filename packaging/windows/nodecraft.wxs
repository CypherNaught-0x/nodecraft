<?xml version="1.0" encoding="utf-8"?>
<!--
  NodeCraft MSI (WiX Toolset v5: `dotnet tool install -g wix`, plus the UI and Util extensions:
  `wix extension add -g WixToolset.UI.wixext/5.0.2 WixToolset.Util.wixext/5.0.2`). Built by package.ps1:

    wix build nodecraft.wxs -arch x64 -ext WixToolset.UI.wixext -ext WixToolset.Util.wixext
      -culture en-US -loc nodecraft.en-us.wxl -d Version=1.2.3 -d DisplayVersion=1.2.3-rc.1
      -d BinDir=... -d IconPath=... -d BannerBmp=... -d DialogBmp=... -o out.msi

  Per-machine install with a setup wizard that names the version: Welcome, install folder
  (Program Files\NodeCraft by default, remembered for upgrades), Ready, a progress page, and a
  Finish page with a ticked "Launch NodeCraft" box. Installs a Start Menu shortcut, makes
  NodeCraft the owner of `.ncraft` project files, and installs nodecraft-cli next to the app.
  `msiexec /qn` still installs silently.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package
      Name="NodeCraft"
      Manufacturer="NodeCraft contributors"
      Version="$(var.Version)"
      UpgradeCode="13885515-39CC-4EE2-9239-54A034A6CDD7"
      Scope="perMachine"
      Compressed="yes"
      Language="1033">
    <SummaryInformation Description="NodeCraft generative media canvas" Manufacturer="NodeCraft contributors" />
    <!-- Same-version upgrades let successive pre-releases of one X.Y.Z replace each other
         (MSI versions are numeric, so 1.2.3-rc.1 and 1.2.3-rc.2 are both 1.2.3). -->
    <MajorUpgrade AllowSameVersionUpgrades="yes"
        DowngradeErrorMessage="A newer version of NodeCraft is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <!-- MSI caches this icon using its Id as the filename. Advertised shortcuts to an
         .exe need an .exe icon identifier (ICE50), even when the source is an ICO. -->
    <Icon Id="NodeCraftIcon.exe" SourceFile="$(var.IconPath)" />
    <Property Id="ARPPRODUCTICON" Value="NodeCraftIcon.exe" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/CypherNaught-0x/nodecraft" />
    <Property Id="ARPURLUPDATEINFO" Value="https://github.com/CypherNaught-0x/nodecraft/releases" />
    <Property Id="ARPHELPLINK" Value="https://github.com/CypherNaught-0x/nodecraft/issues" />

    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLFOLDER" Name="NodeCraft" />
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />

    <!-- An upgrade installs where the user put the previous version (written by NodeCraftApp). -->
    <Property Id="INSTALLFOLDER">
      <RegistrySearch Id="PreviousInstallFolder" Root="HKLM" Key="Software\NodeCraft" Name="InstallDir" Type="raw" />
    </Property>

    <Feature Id="Main" Title="NodeCraft" Level="1">
      <ComponentGroupRef Id="NodeCraftFiles" />
    </Feature>

    <!-- The setup wizard: WixUI_InstallDir without its licence page (the code is MIT OR
         Apache-2.0; there is nothing to accept). A later NewDialog on the same button wins. -->
    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />
    <UI>
      <Publish Dialog="WelcomeDlg" Control="Next" Event="NewDialog" Value="InstallDirDlg" Order="2" Condition="NOT Installed" />
      <Publish Dialog="InstallDirDlg" Control="Back" Event="NewDialog" Value="WelcomeDlg" Order="2" />
      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="LaunchNodeCraft"
          Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 AND NOT Installed" />
    </UI>
    <!-- Our own art, generated by package.ps1 from the app icon (not WiX's stock bitmaps). -->
    <WixVariable Id="WixUIBannerBmp" Value="$(var.BannerBmp)" />
    <WixVariable Id="WixUIDialogBmp" Value="$(var.DialogBmp)" />

    <!-- The full version (Version is numeric, so it drops a pre-release tag), shown on the wizard's
         pages through nodecraft.en-us.wxl. -->
    <Property Id="NodeCraftVersion" Value="$(var.DisplayVersion)" />

    <!-- Finish page: say where to find the app, and offer to start it (ticked by default). -->
    <Property Id="WIXUI_EXITDIALOGOPTIONALTEXT" Value="NodeCraft $(var.DisplayVersion) is installed. You can start it any time from the Start menu." />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Launch NodeCraft" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />
    <Property Id="WixShellExecTarget" Value="[#NodeCraftExe]" />
    <!-- Runs in the wizard's own (unelevated) process, so the app starts as the user, not as admin. -->
    <CustomAction Id="LaunchNodeCraft" BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)" DllEntry="WixShellExec" Impersonate="yes" Return="ignore" />
  </Package>

  <Fragment>
    <ComponentGroup Id="NodeCraftFiles" Directory="INSTALLFOLDER">
      <Component Id="NodeCraftApp" Guid="D4B7829D-C120-4CE0-AD98-A695BCD159FF">
        <File Id="NodeCraftExe" Source="$(var.BinDir)\nodecraft.exe" KeyPath="yes">
          <Shortcut Id="StartMenuShortcut" Directory="ProgramMenuFolder" Name="NodeCraft"
              Description="NodeCraft generative media canvas" WorkingDirectory="INSTALLFOLDER" Advertise="yes"
              Icon="NodeCraftIcon.exe" IconIndex="0" />
        </File>

        <!-- .ncraft: NodeCraft's project file; NodeCraft is its default app. -->
        <ProgId Id="NodeCraft.Project" Description="NodeCraft Project" Icon="NodeCraftExe" IconIndex="0">
          <Extension Id="ncraft" ContentType="application/x-nodecraft">
            <Verb Id="open" Command="Open" TargetFile="NodeCraftExe" Argument="&quot;%1&quot;" />
          </Extension>
        </ProgId>

        <!-- "Open with" app list and the Run dialog (Win+R "nodecraft"). -->
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\nodecraft.exe" Name="FriendlyAppName" Value="NodeCraft" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\nodecraft.exe\shell\open\command" Value="&quot;[#NodeCraftExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\nodecraft.exe\SupportedTypes" Name=".ncraft" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Microsoft\Windows\CurrentVersion\App Paths\nodecraft.exe" Value="[#NodeCraftExe]" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\NodeCraft" Name="InstallDir" Value="[INSTALLFOLDER]" Type="string" />
      </Component>

      <Component Id="NodeCraftCli">
        <File Id="NodeCraftCliExe" Source="$(var.BinDir)\nodecraft-cli.exe" KeyPath="yes" />
      </Component>
    </ComponentGroup>
  </Fragment>
</Wix>
